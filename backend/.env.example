NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
API_PREFIX=/api/v1

# Shared Database Connection URL (TiDB Cloud PostgreSQL)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/test?sslmode=require"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Super Admin Initial Credentials (Used during seed only)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@tilecatalog.com"
SUPER_ADMIN_PASSWORD="YourSecurePasswordHere"
